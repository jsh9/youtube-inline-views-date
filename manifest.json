{
  "manifest_version": 3,
  "name": "YouTube Inline Views & Date",
  "version": "0.1.0",
  "description": "Show views, relative time and the exact date after Subscribe/Join controls on YouTube.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}